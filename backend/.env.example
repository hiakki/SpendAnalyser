# Copy this to .env and adjust as needed.

# Sqlite location (defaults to backend/data/spend.db)
# SPENDA_DB_URL=sqlite:///./data/spend.db

# Enable LLM fallback for uncategorized merchants
SPENDA_LLM_ENABLED=false

# openai | gemini
SPENDA_LLM_PROVIDER=openai
SPENDA_LLM_MODEL=gpt-4o-mini

# Provide one of these if SPENDA_LLM_ENABLED=true
# SPENDA_OPENAI_API_KEY=sk-...
# SPENDA_GEMINI_API_KEY=AIza...

# CORS for the frontend
SPENDA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
